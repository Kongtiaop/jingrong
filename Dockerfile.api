FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt ./
# 国内服务器走清华 PyPI 镜像加速依赖下载；本地/海外可用 --build-arg PIP_INDEX_URL=https://pypi.org/simple 覆盖
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir -r requirements.txt -i ${PIP_INDEX_URL}
COPY app ./app
COPY workers ./workers
COPY scripts ./scripts
COPY migrations ./migrations
# 客户可见语料：供 scripts/import_customer_corpus.py 在容器内导入知识库。
# 必须显式 COPY —— 此前漏掉，导致脚本在容器内报"文件不存在"（compose 未挂载该目录）。
COPY knowledge_corpus ./knowledge_corpus
COPY alembic.ini ./

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

APP_NAME=wealth-manager
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://wealth:wealth_dev@127.0.0.1:5432/wealth_manager
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM_PREFIX=stream:wealth
REDIS_CONSUMER_GROUP=wealth-workers
REDIS_CONSUMER_NAME=worker-1

DASHSCOPE_API_KEY=sk-8524eda4c4564e048b347ab58e32460f
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_SMOKE_CHECK=false
# RAG 关键词检索后端：pg_search（ParadeDB BM25，compose 默认）/ tsvector（Postgres 内置全文，代码兜底）。
# 代码层默认 tsvector 作安全兜底；compose 已默认 pg_search 并切到含 pg_search 的 ParadeDB pg16 镜像。
# 若回退：设 tsvector 并在 compose 把 postgres 镜像换回 pgvector/pgvector:pg16。
FULLTEXT_BACKEND=pg_search

JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

MEMORY_SYNC_TIMEOUT_MS=2500
TASK_MAX_ATTEMPTS=3
TASK_BLOCK_MS=5000

# Daily AML scheduler (UTC). Keep disabled unless the dedicated scheduler worker is running.
AML_SCHEDULER_ENABLED=false
AML_SCHEDULER_POLL_SECONDS=60
AML_SCHEDULER_HOUR_UTC=1
AML_SCHEDULER_MINUTE_UTC=10
AML_SCHEDULER_DAYS=7
# 实时客服：坐席心跳超时暂停；未接入会话超时自动过期，避免测试/遗留会话堆积。
CUSTOMER_SERVICE_HEARTBEAT_TIMEOUT_SECONDS=90
CUSTOMER_SERVICE_WAITING_TIMEOUT_SECONDS=1800
CUSTOMER_SERVICE_WAITING_CLEANUP_ENABLED=true

# Structured LLM intent fallback is opt-in; deterministic planner remains default.
LLM_INTENT_FALLBACK_ENABLED=false
LLM_INTENT_FALLBACK_ALLOWLIST=T1_INFORMATION_QUERY,T2_PRODUCT_RECOMMENDATION,T7_HUMAN_HANDOFF
LLM_INTENT_SHADOW_ENABLED=false
LLM_INTENT_FALLBACK_TIMEOUT_SECONDS=8
LLM_INTENT_FALLBACK_MAX_CONCURRENCY=4

# LangGraph Supervisor 真图接线（渐进式，默认全关 → 生产走确定性管线）
# AGENT_GRAPH_ENABLED=true     时 API 改走 LangGraph 编译图（替换管线执行）
# AGENT_GRAPH_SHADOW_ENABLED=true 时管线照常返回，图在旁路跑一遍并写审计对照（切流前用）
# AGENT_CHECKPOINT_ENABLED=true  时启用 Postgres checkpointer（断点续跑，thread_id=conversation_id）
AGENT_GRAPH_ENABLED=false
AGENT_GRAPH_SHADOW_ENABLED=false
AGENT_CHECKPOINT_ENABLED=false
# ReAct 预算：必须与管线 CustomerTaskExecutor.MAX_REACT_ITERATIONS/MAX_REACT_TOOL_CALLS 对齐（均 20），
# 否则同一 query 两条路径检索尝试次数不同，双跑对照不公平。
AGENT_GRAPH_MAX_ITERATIONS=20
AGENT_GRAPH_MAX_TOOL_CALLS=20
